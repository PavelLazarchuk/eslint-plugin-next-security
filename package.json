{
    "name": "eslint-plugin-next-security",
    "version": "1.0.0",
    "description": "ESLint rules for the Next.js App Router attack surface: unguarded Server Actions, data-layer imports outside the DAL, unvalidated FormData reaching the database.",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "scripts": {
        "build": "tsup && node scripts/fix-cjs-types.mjs",
        "dev": "tsup --watch --onSuccess \"node scripts/fix-cjs-types.mjs\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docs": "npm run build && eslint-doc-generator",
        "docs:check": "eslint-doc-generator --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "compat": "node scripts/compat-check.mjs",
        "check-exports": "publint && attw --pack .",
        "size": "size-limit",
        "pack:verify": "npm pack --dry-run",
        "changeset": "changeset",
        "release": "npm run build && node scripts/publish-if-new.mjs",
        "prepare": "husky"
    },
    "dependencies": {
        "minimatch": "^10.0.3"
    },
    "peerDependencies": {
        "eslint": ">=8.57.0"
    },
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "nextjs",
        "next",
        "app-router",
        "server-actions",
        "use-server",
        "rsc",
        "react-server-components",
        "security",
        "authorization",
        "authentication",
        "auth-guard",
        "access-control",
        "data-access-layer",
        "dal",
        "taint-analysis",
        "formdata",
        "input-validation",
        "zod",
        "valibot",
        "prisma",
        "drizzle",
        "sql-injection",
        "linter",
        "lint",
        "typescript"
    ],
    "author": "Pavel Lazarchuk",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PavelLazarchuk/eslint-plugin-next-security.git"
    },
    "bugs": {
        "url": "https://github.com/PavelLazarchuk/eslint-plugin-next-security/issues"
    },
    "homepage": "https://github.com/PavelLazarchuk/eslint-plugin-next-security#readme",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^10.0.1",
        "@size-limit/preset-small-lib": "^13.0.3",
        "@types/node": "^26.4.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-doc-generator": "^3.7.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6",
        "publint": "^0.3.24",
        "size-limit": "^13.0.3",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "tsup": {
            "esbuild": "^0.28.2"
        }
    }
}
